@page "/documents"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@attribute [Authorize]
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ContosoDashboard.Data.ApplicationDbContext Db
@inject IJSRuntime JS

<PageTitle>My Documents - ContosoDashboard</PageTitle>

<div class="container-fluid document-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div><h1>My Documents</h1><p class="text-muted mb-0">Upload and find protected work files.</p></div>
        <label class="btn btn-primary mb-0">
            <span class="bi bi-upload" aria-hidden="true"></span> Choose files
            <InputFile OnChange="HandleFilesSelected" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.jpg,.jpeg,.png" class="visually-hidden" />
        </label>
    </div>

    @if (!string.IsNullOrEmpty(message)) { <div class="alert @(isError ? "alert-danger" : "alert-success")" role="status">@message</div> }
    @if (selectedFiles.Count > 0)
    {
        <section class="card mb-4" aria-labelledby="upload-heading">
            <div class="card-body">
                <h2 id="upload-heading" class="h4">Upload selected files</h2>
                <div class="row g-3">
                    <div class="col-md-4"><label for="document-title" class="form-label">Title</label><input id="document-title" class="form-control" @bind="title" /></div>
                    <div class="col-md-4"><label for="document-category" class="form-label">Category</label><select id="document-category" class="form-select" @bind="category">@foreach (var option in DocumentFeatureOptions.Categories) { <option value="@option">@option</option> }</select></div>
                    <div class="col-md-4"><label for="document-project" class="form-label">Project ID (optional)</label><input id="document-project" type="number" class="form-control" @bind="projectId" /></div>
                    <div class="col-md-8"><label for="document-description" class="form-label">Description</label><textarea id="document-description" class="form-control" @bind="description"></textarea></div>
                    <div class="col-md-4"><label for="document-tags" class="form-label">Tags</label><input id="document-tags" class="form-control" @bind="tags" placeholder="e.g. planning, q4" /></div>
                </div>
                <ul class="list-group my-3">@foreach (var file in selectedFiles) { <li class="list-group-item d-flex justify-content-between"><span>@file.Name</span><span>@FormatSize(file.Size)</span></li> }</ul>
                <button class="btn btn-success" @onclick="UploadFiles" disabled="@isUploading"><span class="bi bi-cloud-arrow-up" aria-hidden="true"></span> @(isUploading ? "Uploading..." : "Upload")</button>
            </div>
        </section>
    }

    <div class="d-flex flex-wrap gap-2 mb-3">
        <label for="document-search" class="visually-hidden">Search documents</label><input id="document-search" class="form-control document-search" placeholder="Search title, description, tags, uploader, or project" @bind="search" @bind:event="oninput" @onkeydown="HandleSearchKeyDown" />
        <select class="form-select document-filter" aria-label="Filter by category" @bind="filterCategory"><option value="">All categories</option>@foreach (var option in DocumentFeatureOptions.Categories) { <option value="@option">@option</option> }</select>
        <button class="btn btn-outline-secondary" @onclick="LoadDocuments"><span class="bi bi-search" aria-hidden="true"></span> Search</button>
    </div>
    @if (documents is null) { <p role="status"><em>Loading documents...</em></p> }
    else if (documents.Count == 0) { <div class="alert alert-info">No accessible documents match your search.</div> }
    else {
        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Title</th><th>Category</th><th>Project</th><th>Uploaded</th><th>Size</th><th>Actions</th></tr></thead><tbody>
        @foreach (var document in documents) { <tr @key="document.DocumentId"><td><strong>@document.Title</strong><br /><small class="text-muted">@document.UploaderName</small></td><td>@document.Category</td><td>@(document.ProjectName ?? "Personal")</td><td>@document.UploadedAt.ToLocalTime().ToString("MMM dd, yyyy")</td><td>@FormatSize(document.FileSize)</td><td><a class="btn btn-sm btn-outline-primary me-1" href="/documents/@document.DocumentId/download" title="Download @document.Title"><span class="bi bi-download" aria-hidden="true"></span><span class="visually-hidden">Download</span></a><button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => BeginEdit(document)" title="Edit @document.Title"><span class="bi bi-pencil" aria-hidden="true"></span><span class="visually-hidden">Edit</span></button><button class="btn btn-sm btn-outline-info me-1" @onclick="() => BeginShare(document.DocumentId)" title="Share @document.Title"><span class="bi bi-share" aria-hidden="true"></span><span class="visually-hidden">Share</span></button><button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteDocument(document.DocumentId)" title="Delete @document.Title"><span class="bi bi-trash" aria-hidden="true"></span><span class="visually-hidden">Delete</span></button></td></tr>}
        </tbody></table></div>
    }
    @if (editingDocument is not null)
    {
        <section class="card mt-4" aria-labelledby="edit-document-heading">
            <div class="card-body">
                <h2 id="edit-document-heading" class="h4">Edit document</h2>
                <div class="row g-3">
                    <div class="col-md-4"><label for="edit-title" class="form-label">Title</label><input id="edit-title" class="form-control" @bind="editTitle" /></div>
                    <div class="col-md-4"><label for="edit-category" class="form-label">Category</label><select id="edit-category" class="form-select" @bind="editCategory">@foreach (var option in DocumentFeatureOptions.Categories) { <option value="@option">@option</option> }</select></div>
                    <div class="col-md-4"><label for="edit-tags" class="form-label">Tags</label><input id="edit-tags" class="form-control" @bind="editTags" /></div>
                    <div class="col-12"><label for="edit-description" class="form-label">Description</label><textarea id="edit-description" class="form-control" @bind="editDescription"></textarea></div>
                    <div class="col-md-6"><label for="replacement-file" class="form-label">Replace file</label><InputFile id="replacement-file" OnChange="SelectReplacement" /></div>
                </div>
                <div class="mt-3"><button class="btn btn-primary me-2" @onclick="SaveEdit" disabled="@isBusy">Save changes</button><button class="btn btn-outline-secondary" @onclick="CancelEdit" disabled="@isBusy">Cancel</button></div>
            </div>
        </section>
    }
    @if (shareDocumentId.HasValue)
    {
        <section class="card mt-4" aria-labelledby="share-document-heading">
            <div class="card-body">
                <h2 id="share-document-heading" class="h4">Share document</h2>
                <div class="row g-3"><div class="col-md-6"><label for="share-user" class="form-label">User ID</label><input id="share-user" type="number" class="form-control" @bind="shareUserId" /></div><div class="col-md-6"><label for="share-department" class="form-label">Team department</label><input id="share-department" class="form-control" @bind="shareDepartment" /></div></div>
                <div class="mt-3"><button class="btn btn-primary me-2" @onclick="ShareDocument" disabled="@isBusy">Share</button><button class="btn btn-outline-secondary" @onclick="CancelShare" disabled="@isBusy">Cancel</button></div>
            </div>
        </section>
    }
</div>

@code {
    private List<IBrowserFile> selectedFiles = new();
    private List<DocumentSummary>? documents;
    private string title = "", description = "", category = DocumentFeatureOptions.Categories[0], tags = "", search = "", filterCategory = "", message = "";
    private int? projectId;
    [SupplyParameterFromQuery(Name = "taskId")] public int? TaskId { get; set; }
    private int currentUserId;
    private bool isUploading, isError, isBusy;
    private DocumentSummary? editingDocument;
    private IBrowserFile? replacementFile;
    private string editTitle = "", editDescription = "", editCategory = "", editTags = "";
    private int? shareDocumentId, shareUserId;
    private string? shareDepartment;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ResolveUser();
            if (TaskId.HasValue) projectId = await Db.Tasks.Where(t => t.TaskId == TaskId).Select(t => t.ProjectId).FirstOrDefaultAsync();
            await LoadDocuments();
        }
        catch (Exception)
        {
            documents = new List<DocumentSummary>();
            isError = true;
            message = "Documents could not be loaded. Restart the application and try again.";
        }
    }
    private async Task ResolveUser() { var state = await AuthenticationStateProvider.GetAuthenticationStateAsync(); int.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier), out currentUserId); }
    private void HandleFilesSelected(InputFileChangeEventArgs args) { selectedFiles = args.GetMultipleFiles(20).ToList(); message = ""; }
    private async Task UploadFiles()
    {
        isUploading = true; isError = false; message = "";
        try
        {
            if (string.IsNullOrWhiteSpace(title)) throw new InvalidOperationException("A title is required.");
            foreach (var browserFile in selectedFiles)
            {
                await using var source = browserFile.OpenReadStream(25L * 1024 * 1024);
                await using var buffer = new MemoryStream(); await source.CopyToAsync(buffer); buffer.Position = 0;
                await DocumentService.UploadAsync(currentUserId, new DocumentUploadMetadata(title, description, category, projectId, tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries), Path.GetFileName(browserFile.Name), browserFile.ContentType, browserFile.Size, TaskId), buffer);
            }
            selectedFiles.Clear(); message = "Document upload completed."; await LoadDocuments();
        }
        catch (DocumentUploadException ex) { isError = true; message = ex.Message; }
        catch (Exception ex) when (ex is IOException or InvalidOperationException) { isError = true; message = ex.Message; }
        finally { isUploading = false; }
    }
    private async Task LoadDocuments() { if (currentUserId > 0) documents = (await DocumentService.SearchAsync(currentUserId, new DocumentQuery(search, filterCategory))).Items.ToList(); }
    private void BeginEdit(DocumentSummary document) { editingDocument = document; editTitle = document.Title; editDescription = document.Description ?? ""; editCategory = document.Category; editTags = document.Tags ?? ""; message = ""; }
    private void CancelEdit() { editingDocument = null; replacementFile = null; }
    private void SelectReplacement(InputFileChangeEventArgs args) => replacementFile = args.File;
    private async Task SaveEdit()
    {
        if (editingDocument is null) return;
        isBusy = true; isError = false;
        try
        {
            var tagsToSave = editTags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (!await DocumentService.UpdateMetadataAsync(currentUserId, editingDocument.DocumentId, new DocumentMetadataChanges(editTitle, editDescription, editCategory, tagsToSave))) throw new InvalidOperationException("You are not allowed to edit this document.");
            if (replacementFile is not null)
            {
                await using var source = replacementFile.OpenReadStream(25L * 1024 * 1024);
                if (!await DocumentService.ReplaceFileAsync(currentUserId, editingDocument.DocumentId, source, replacementFile.Name, replacementFile.ContentType, replacementFile.Size)) throw new InvalidOperationException("You are not allowed to replace this document.");
            }
            message = "Document changes saved."; editingDocument = null; replacementFile = null; await LoadDocuments();
        }
        catch (Exception ex) when (ex is DocumentUploadException or InvalidOperationException or IOException) { isError = true; message = ex.Message; }
        finally { isBusy = false; }
    }
    private async Task DeleteDocument(int documentId)
    {
        if (!await JsConfirmAsync("Permanently delete this document?")) return;
        isBusy = true; isError = false;
        try { if (!await DocumentService.DeleteAsync(currentUserId, documentId)) throw new InvalidOperationException("You are not allowed to delete this document."); message = "Document deleted."; await LoadDocuments(); }
        catch (Exception ex) when (ex is InvalidOperationException or IOException) { isError = true; message = ex.Message; }
        finally { isBusy = false; }
    }
    private void BeginShare(int documentId) { shareDocumentId = documentId; shareUserId = null; shareDepartment = null; }
    private void CancelShare() => shareDocumentId = null;
    private async Task ShareDocument()
    {
        if (!shareDocumentId.HasValue || (!shareUserId.HasValue && string.IsNullOrWhiteSpace(shareDepartment))) { isError = true; message = "Choose a user or department."; return; }
        isBusy = true; isError = false;
        try { if (!await DocumentService.ShareAsync(currentUserId, shareDocumentId.Value, new[] { new DocumentShareTarget(shareUserId, shareDepartment) })) throw new InvalidOperationException("You are not allowed to share this document."); message = "Document shared."; shareDocumentId = null; }
        catch (InvalidOperationException ex) { isError = true; message = ex.Message; }
        finally { isBusy = false; }
    }
    private async Task<bool> JsConfirmAsync(string prompt) => await JS.InvokeAsync<bool>("confirm", prompt);
    private Task HandleSearchKeyDown(KeyboardEventArgs args) => args.Key == "Enter" ? LoadDocuments() : Task.CompletedTask;
    private static string FormatSize(long bytes) => bytes < 1024 ? $"{bytes} B" : bytes < 1024 * 1024 ? $"{bytes / 1024d:0.0} KB" : $"{bytes / 1024d / 1024d:0.0} MB";
}
